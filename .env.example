# Copy this file to .env and fill in the values. Never commit .env.
# None of these use the NEXT_PUBLIC_ prefix: they are server-only and never sent to the browser.

# Postgres connection string (matches docker-compose.yml).
DATABASE_URL="postgresql://movie:movie@localhost:54330/movie_memory?schema=public"

# Separate database used only by the test suite (created by docker/init-test-db.sql).
DATABASE_URL_TEST="postgresql://movie:movie@localhost:54330/movie_memory_test?schema=public"

# Random secret used by Auth.js to sign/encrypt cookies. Generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth client ID and secret (Google Cloud Console > APIs & Services > Credentials).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OpenAI API key (https://platform.openai.com/api-keys).
OPENAI_API_KEY=""

# Optional: OpenAI model for fact generation. Defaults to gpt-6-luna if unset.
OPENAI_MODEL=""
